{
  "manifest_version": 3,
  "name": "Keyhold",
  "version": "1.0",
  "description": "Import Property24 listings into your Keyhold CRM.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.property24.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import to Keyhold"
  }
}
